# Copy this file to .env and fill in your local values.
# Never put real credentials in this example file.
APP_TITLE="AWS Cost Optimizer"
AWS_REGION=us-east-1

# Required: backend endpoint including the stage and /optimize path.
API_GATEWAY_URL=

# Optional: required only for AI features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
